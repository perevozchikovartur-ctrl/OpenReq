# OpenReq Environment Variables

# Registration settings
ALLOW_REGISTRATION=true

# JWT settings
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0

# Database
DATABASE_URL=sqlite:///./data/openreq.db

# CORS
CORS_ORIGINS=*

# Environment
ENVIRONMENT=development

# Proxy
PROXY_REQUEST_TIMEOUT=30

# Authentication. Set LOCAL_AUTH_ENABLED=false after confirming OIDC login works.
LOCAL_AUTH_ENABLED=true

# Keycloak / OpenID Connect (leave issuer and client ID empty to disable OIDC)
OIDC_ISSUER_URL=https://sso.perevozchikov-artur.ru/realms/perevozchikov-artur
OIDC_CLIENT_ID=openreq
OIDC_CLIENT_SECRET=SQufl17btkPCZpYuvYOPfgbLAwLmksi1
OIDC_REDIRECT_URI=http://172.20.100.145/api/v1/auth/oidc/callback
OIDC_FRONTEND_URL=http://172.20.100.145
# Realm/client role → instance role; only instance_admin is privileged.
OIDC_INSTANCE_ROLE_MAP={"openreq-admin":"admin"}
# Optional automatic membership in one workspace (UUID):
OIDC_DEFAULT_WORKSPACE_ID=
OIDC_WORKSPACE_ROLE_MAP={"openreq-workspace-admin":"admin","openreq-workspace-editor":"editor","openreq-workspace-viewer":"viewer"}